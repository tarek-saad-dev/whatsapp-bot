[Unit]
Description=DRVOWA Cut Salon Baileys v7 canary (experiment only)
After=network.target
# Intentionally independent from whatsapp-bot.service

[Service]
Type=simple
User=whatsapp
Group=whatsapp
WorkingDirectory=/home/whatsapp/canary/baileys-v7-cut-canary
Environment=NODE_ENV=production
Environment=CANARY_AUTH_DIR=/home/whatsapp/canary-auth/cut-salon-v7
Environment=CANARY_HTTP_PORT=3017
Environment=CANARY_LOG_LEVEL=warn
Environment=CANARY_ACCOUNT_KEY=wa_f09d54055f079b2624800b46
Environment=CANARY_S2S_ENABLED=true
Environment=CANARY_OUTBOUND_ENABLED=true
Environment=CANARY_OUTBOUND_ALLOWED_PHONE=201557994946
