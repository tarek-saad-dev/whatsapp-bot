# Copy this file to .env and fill in your values:
#   copy .env.example .env

KEEP_LOGIN=true
USE_DEFAULT_CHROME=true
CHROME_PATH=

# Use a dedicated Chrome profile folder (not your personal Chrome profile)
WHATSAPP_CHROME_PROFILE_DIR=C:\\Users\\YOUR_USER\\Desktop\\whatsapp-bot-clean\\chrome-profile-automessage
WHATSAPP_CHROME_PROFILE_NAME=BotProfile
WHATSAPP_DEBUG_PORT=9222
WHATSAPP_WEB_URL=https://web.whatsapp.com

DEFAULT_DELAY_MS=4000
USE_RANDOM_DELAY=true
MIN_DELAY_MS=1000
MAX_DELAY_MS=2000

EXCEL_FILE=contacts.xlsx
EXCEL_SHEET=BOT

# Change this to a long random secret before production use
SQL_TRIGGER_TOKEN=your-secret-token-change-this

# Optional dedicated test number for gateway e2e (never a real customer from DB)
# WHATSAPP_E2E_TEST_PHONE=2015XXXXXXXX

# SQL Server (required for offers / audience / sales features)
DB_SERVER=YOUR_PC_NAME_OR_IP
DB_NAME=YourDatabaseName
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_ENCRYPT=false
DB_TRUST_CERT=true

# SMS provider (optional — only if you use SMS fallback)
SMS_HUB_API_URL=https://hubapi.advansystelecom.com/api/bulkSMS/ForwardSMS
SMS_HUB_API_KEY=your-sms-api-key
SMS_HUB_SENDER_NAME=YourSenderName

CAMPAIGN_BATCH_SIZE=3
CAMPAIGN_BATCH_DELAY_MS=1000
CAMPAIGN_MESSAGE_DELAY_MS=40000
CAMPAIGN_POLL_INTERVAL_MS=5000

PORT=3000
ENABLE_CAMPAIGN_WORKER=false

# Phase 1 inbound → Cashier delivery
WHATSAPP_INBOX_LISTEN=true
WHATSAPP_INBOX_DRAIN_MS=1500
WHATSAPP_INBOX_ACTIVE_DRAIN_MS=500
WHATSAPP_INBOX_DELIVERY_INTERVAL_MS=1000
WHATSAPP_INBOX_MAX_CHATS_PER_POLL=5
WHATSAPP_INBOX_INCLUDE_GROUPS=false
# WHATSAPP_INBOX_WEBHOOK_URL=http://127.0.0.1:<cashier-port>/api/internal/messaging/inbox/whatsapp
# WHATSAPP_INBOX_WEBHOOK_TOKEN=your-internal-token
# WHATSAPP_INBOX_SPOOL_FILE=data/inbox-spool.json
# WHATSAPP_INBOX_SPOOL_MAX_DELIVERED=500
# WHATSAPP_INBOX_SPOOL_DELIVERED_RETENTION_MS=604800000
